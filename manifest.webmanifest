{
  "name": "小账本 · 本地记账",
  "short_name": "小账本",
  "description": "纯本地的记账应用：记录每天的花销，数据不出你的设备",
  "lang": "zh-CN",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#DFF4E9",
  "theme_color": "#00B578",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "记一笔",
      "short_name": "记一笔",
      "description": "直接开始记账，光标已就位",
      "url": "./index.html?action=add",
      "icons": [{ "src": "icons/shortcut-add.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "记一餐",
      "short_name": "记一餐",
      "description": "打开饮食页，一句话记下这餐",
      "url": "./index.html?action=meal",
      "icons": [{ "src": "icons/shortcut-meal.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "看统计",
      "short_name": "看统计",
      "description": "直达统计页",
      "url": "./index.html?view=stats",
      "icons": [{ "src": "icons/shortcut-stats.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "背单词",
      "short_name": "背单词",
      "description": "直达背单词分段，继续今日任务",
      "url": "./index.html?view=life&mod=vocab"
    },
    {
      "name": "看日子",
      "short_name": "看日子",
      "description": "直达纪念日/倒计时与打卡计划",
      "url": "./index.html?view=life&mod=days"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
